# Fixed, checked-in secrets for the throwaway instance docker-compose.yml brings up. This is not a production
# credential leak: the instance they belong to exists only for the length of one test run, on loopback only, seeded
# with one test account and nothing else worth protecting. Generated once with `openssl rand -hex`; there is no
# reason to rotate a secret nothing relies on staying secret.

LOCAL_DOMAIN=localhost
SINGLE_USER_MODE=false

DB_HOST=db
DB_PORT=5432
DB_NAME=mastodon_test
DB_USER=mastodon
DB_PASS=wooly-integration-test

REDIS_HOST=redis
REDIS_PORT=6379

SECRET_KEY_BASE=04e2640642f9745484faa98deb6d9551c712ef98cea39bbd7f0742af9a2c653df2f171192ae24c16dffdf1f7e02e82cddf25359b8c65f15647d6c515e1f1d659
OTP_SECRET=2c3a0859229dff9919355efbde24aec4a21d43e55eebd503629d53924e2537a13ff28303d97bdc1cc1f444d765cd01d0bc06b1d4f8cb993f47868cd6a886d599
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=f164e00fc996b1fe44eb4adba95012d52bf13f8a8f4e457683ac6e4239abbd69
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=7138049bf6cfb5edf675a6e86767491a0fc451591bb57e3353625f9908dd0e49
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=e6094ba5d7a2ce356c427e3856f90966dc538f203dd34cb29aff719776c73e73

RAILS_LOG_TO_STDOUT=true

# The seeded test account's address (see seed.sh) is never sent anything and needs no real mailbox, but Mastodon
# still checks that its domain resolves an MX record before it will accept it — an allowlist is how that check is
# skipped for a domain that was never going to resolve one, without turning the check off for every domain.
EMAIL_DOMAIN_ALLOWLIST=example.com

# No SMTP is configured, and nothing here triggers mail: the seed script confirms the test account through tootctl
# rather than the email flow, so there is no delivery to fail.
