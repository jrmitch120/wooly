<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Wooly</Product>
    <!-- What a local build reports. A release overrides it from the tag being built (see docs/releases.md), so this
         value is the developer's default rather than the number users see. -->
    <Version>0.1.0</Version>
    <Authors>Jeff Mitchell</Authors>
    <Company>Wooly</Company>
  </PropertyGroup>

</Project>
